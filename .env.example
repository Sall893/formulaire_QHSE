PORT=3008

# Adresse e-mail du responsable qui reçoit les signalements HSE
RECIPIENT_EMAIL=responsable-hse@powertech-group.com

# Configuration SMTP (Optionnel - Exemple pour Gmail ou SMTP Entreprise)
# Si ces champs sont vides, le mode test automatique permet de voir les emails reçus en un clic !
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL="Système HSE Powertech" <alerte-hse@powertech-group.com>
